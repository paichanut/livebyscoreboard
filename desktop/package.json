{
  "name": "live-by-scoreboard-desktop",
  "productName": "Live by Scoreboard 2026",
  "version": "1.0.0",
  "description": "Live by Scoreboard 2026 — offline, one computer, display on HDMI (licensed until the end of 2026)",
  "author": "Pai Chanut",
  "main": "main.cjs",
  "expires": "2026-12-31",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win msi nsis portable --publish never"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "app.livebyscoreboard.desktop",
    "productName": "Live by Scoreboard 2026",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "updater.cjs",
      "preload.cjs",
      "share.cjs",
      "teams.cjs",
      "teams-preload.cjs",
      "license.cjs",
      "display-preload.cjs",
      "web/**/*"
    ],
    "icon": "icon.png",
    "win": {
      "target": [
        "msi",
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Live by Scoreboard 2026",
      "artifactName": "LiveByScoreboard-2026-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "LiveByScoreboard-2026-Portable-${version}.exe"
    },
    "msi": {
      "oneClick": false,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Live by Scoreboard 2026",
      "artifactName": "LiveByScoreboard-2026-${version}.msi"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "paichanut",
        "repo": "livebyscoreboard"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "6.3.9"
  }
}
