# Copy to .env (local) or add these in Vercel → Project → Settings → Environment Variables
# Both are required: without them the app shows the setup screen (cloud mode only).
# Tests use `vite build --mode test` (.env.test) which enables a same-browser local store instead.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Server only (Vercel functions, never VITE_*): FullRink "My boards" (api/fullrink.js, supabase/fullrink-owners.sql)
# SUPABASE_SERVICE_ROLE_KEY=
